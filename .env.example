# Copy to .env and adjust.

# Required: Postgres connection string used by both orchestrator and worker.
DATABASE_URL=postgres://postgres:secret@postgres:5432/forge?sslmode=disable

# Used by Caddy / DuckDNS for HTTPS.
DUCKDNS_TOKEN=

# Optional: override the auto-generated worker ID.
# WORKER_ID=worker-1

# ---- Week 6: Observability configuration ----
# Logging format: "text" (human readable) | "json" (structured for log aggregators)
LOG_FORMAT=text

# Logging level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# OpenTelemetry OTLP HTTP endpoint (Week 6). When set, trace.Setup adds an OTLP
# exporter alongside the slog span lines so spans reach a collector/Jaeger
# (docker compose --profile observability + http://jaeger:4318). Leave unset for
# slog-only (zero infrastructure) tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Comma-separated map of worker metrics URLs proxied by orchestrator GET /api/worker-metrics/{worker}
WORKER_METRICS_URLS=worker-1=http://worker-1:9091/metrics,worker-2=http://worker-2:9091/metrics,worker-3=http://worker-3:9091/metrics,worker-4=http://worker-4:9091/metrics

# ---- Week 4: Agent / LLM configuration ----
# Backend used by the cp_solve agent: "ollama" (local) | "groq" (cloud) | "fake" (zero-cost testing).
LLM_BACKEND=ollama

# Ollama backend (local inference).
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Groq backend (cloud inference). Requires GROQ_API_KEY; LLM_BACKEND=groq.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.1-8b-instant

# Shared LLM client tuning.
# LLM_TIMEOUT=60s
# LLM_MAX_RETRIES=3

# Max agent iterations (plan+tool pairs) before a poison job is failed.
# AGENT_MAX_STEPS=10

# Per-test-case timeout for the agent's run_tests tool, in milliseconds.
# RUN_TESTS_TIMEOUT_MS=2000

# ---- Week 5: Rate Limiting & Backpressure configuration ----
# Maximum pending jobs allowed in POST /jobs before returning HTTP 429 (admission control).
# MAX_PENDING_JOBS=50

# Worker-side LLM Rate Limiting (Token-Bucket per minute).
# RATE_LIMIT_BACKEND=memory              # "off" | "memory" | "upstretch" (distributed Redis)
# RATE_LIMIT_TPM=60000
# RATE_LIMIT_RPM=30

# Upstretch distributed rate limiter (requires RATE_LIMIT_BACKEND=upstretch).
# UPSTASH_URL=https://your-instance.upstash.io
# UPSTASH_TOKEN=your-upstash-rest-token

# Prometheus seed metrics endpoint served by each worker on METRICS_PORT (default 9091).
# METRICS_PORT=9091
